# Kopie als .env anlegen. Ohne DATABASE_URL nutzt Lumé eine eingebaute
# Test-Datenbank im Ordner .data/ (nichts zu installieren).
# DATABASE_URL=postgres://lume:lume@localhost:5432/lume

# Port der API
PORT=4000

# Nur für die lokale Entwicklung: Demo-Studio mit Demo-Login und festem Schlüssel.
LUME_DEMO_SEED=1
LUME_DEV_EMAIL=demo@lume.local
LUME_DEV_PASSWORD=demo-passwort-lokal
LUME_DEV_API_KEY=lume_dev_nur_lokal_demo_schluessel

# Backoffice und MCP-Server: wo die API läuft
LUME_API_URL=http://localhost:4000
# Nur für den MCP-Server: Schlüssel des Studios (im Backoffice unter "API-Schlüssel" anlegen)
LUME_API_KEY=lume_dev_nur_lokal_demo_schluessel
