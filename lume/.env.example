# Kopie als .env anlegen. Ohne DATABASE_URL nutzt Lumé eine eingebaute
# Test-Datenbank im Ordner .data/ (nichts zu installieren).
# DATABASE_URL=postgres://lume:lume@localhost:5432/lume

# Port der API
PORT=4000

# Nur für die lokale Entwicklung: Demo-Studio mit festem Schlüssel anlegen.
LUME_DEMO_SEED=1
LUME_DEV_API_KEY=lume_dev_nur_lokal_demo_schluessel

# Backoffice: wo die API läuft und mit welchem Schlüssel es spricht
LUME_API_URL=http://localhost:4000
LUME_API_KEY=lume_dev_nur_lokal_demo_schluessel
