    "hono": "^4.13.17",
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
